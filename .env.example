# ─────────────────────────────────────────────────
# Person Blog — Environment Variables Template
# Copy this file to .env and adjust values
# ─────────────────────────────────────────────────

# ── Django Core ──────────────────────────────────
DEBUG=on
SECRET_KEY=change-me-to-a-random-secret-key-at-least-50-characters-long
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development

# ── Database (PostgreSQL) ────────────────────────
# Format: psql://USER:PASSWORD@HOST:PORT/DBNAME
# Leave empty to use SQLite for local development
DATABASE_URL=
DB_CONN_MAX_AGE=60
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=5

# ── Redis ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ───────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Email ────────────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# ── Sentry ───────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Storage (AWS S3 / MinIO) ─────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1

# ── CORS ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Site ─────────────────────────────────────────
SITE_NAME=Person Blog
SITE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
